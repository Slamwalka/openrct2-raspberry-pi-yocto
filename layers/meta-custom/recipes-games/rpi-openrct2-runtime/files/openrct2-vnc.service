[Unit]
Description=Loopback-only VNC access to the OpenRCT2 DSI display
Requires=openrct2-display.service
After=openrct2-display.service
ConditionPathExists=/sys/class/drm/card1-DSI-1/status

[Service]
Type=simple
ExecCondition=/bin/sh -c 'test "$(cat /sys/class/drm/card1-DSI-1/status)" = connected'
ExecStart=/usr/bin/x11vnc -display :0 -auth /run/openrct2-display/Xauthority -localhost -nopw -rfbport 5900 -forever -shared -noxdamage -noshm -repeat -rotate nc:180 -norotatepointer
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
