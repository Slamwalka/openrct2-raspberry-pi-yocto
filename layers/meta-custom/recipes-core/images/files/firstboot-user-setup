#!/bin/sh
set -eu

marker=/var/lib/rpi-firstboot/user-configured
key_source=/usr/share/rpi-firstboot/authorized_keys
sudoers_file=/etc/sudoers.d/90-firstboot-user
tty_state=

if [ -e "$marker" ]; then
    exit 0
fi

exec </dev/console >/dev/console 2>&1
tty_state=$(stty -g)
restore_tty() {
    stty "$tty_state" 2>/dev/null || true
}
trap restore_tty 0 HUP INT TERM

printf '\nErsteinrichtung des Raspberry-Pi-Systems\n'
while :; do
    printf 'Benutzername [openrct2]: '
    IFS= read -r username || exit 1
    [ -n "$username" ] || username=openrct2

    case "$username" in
        [a-zA-Z_][a-zA-Z0-9_.-]*) ;;
        *) printf 'Ungueltiger Benutzername.\n'; continue ;;
    esac

    [ "$username" != root ] || {
        printf 'root ist als Benutzername nicht erlaubt.\n'
        continue
    }

    if id "$username" >/dev/null 2>&1; then
        uid=$(id -u "$username")
        case "$uid" in
            ''|*[!0-9]*) printf 'Benutzer kann nicht verwendet werden.\n'; continue ;;
        esac
        if [ "$uid" -lt 1000 ]; then
            printf 'Systemkonten koennen nicht verwendet werden.\n'
            continue
        fi
        printf 'Benutzer existiert bereits; Passwort und SSH-Schluessel werden aktualisiert.\n'
    else
        useradd -m -U -s /bin/sh "$username"
    fi
    break
done

while :; do
    printf 'Passwort: '
    stty -echo
    IFS= read -r password || exit 1
    stty "$tty_state"
    printf '\nPasswort wiederholen: '
    stty -echo
    IFS= read -r password_confirm || exit 1
    stty "$tty_state"
    printf '\n'

    if [ -n "$password" ] && [ "$password" = "$password_confirm" ]; then
        break
    fi
    unset password password_confirm
    printf 'Passwoerter leer oder unterschiedlich. Bitte erneut versuchen.\n'
done

printf '%s:%s\n' "$username" "$password" | chpasswd
unset password password_confirm

home=$(getent passwd "$username" | cut -d: -f6)
group=$(id -gn "$username")
if [ -s "$key_source" ]; then
    mkdir -p "$home/.ssh"
    chmod 0700 "$home/.ssh"
    touch "$home/.ssh/authorized_keys"
    while IFS= read -r public_key || [ -n "$public_key" ]; do
        case "$public_key" in
            ''|\#*) continue ;;
        esac
        grep -F -x "$public_key" "$home/.ssh/authorized_keys" >/dev/null 2>&1 ||
            printf '%s\n' "$public_key" >> "$home/.ssh/authorized_keys"
    done < "$key_source"
    chown -R "$username:$group" "$home/.ssh"
    chmod 0600 "$home/.ssh/authorized_keys"
fi

sudoers_tmp=/run/90-firstboot-user
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$username" > "$sudoers_tmp"
chmod 0440 "$sudoers_tmp"
visudo -cf "$sudoers_tmp" >/dev/null
mv "$sudoers_tmp" "$sudoers_file"

passwd -l root
mkdir -p "${marker%/*}"
touch "$marker"
printf 'Ersteinrichtung abgeschlossen. SSH-Schluessel und sudo sind eingerichtet.\n'